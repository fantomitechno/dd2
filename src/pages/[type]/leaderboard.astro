---
import GlobalLayout from "../../layouts/GlobalLayout.astro";
import PageHeader from "../../components/others/DSPageHeader.astro";
import LeaderboardPage from "../../components/others/LeaderboardPage.astro";
import { getLeaderboardSize } from "../../utils/other_api";
import { getMapName } from "../../utils/other_maps";

const { type } = Astro.params;
const page = parseInt(Astro.url.searchParams.get("page") ?? "0");

const leaderboardSize = await getLeaderboardSize(type!);
---

<GlobalLayout title={"leaderboard | " + getMapName(type!)}>
  <PageHeader>Leaderboard</PageHeader>

  <LeaderboardPage page={page} type={type!} />
  <div class="spacer"></div>

  <span>
    {page > 0 && <a href={"/" + type + "/leaderboard?page=0"}>{"<<-"}</a>}
    {
      page > 0 && (
        <a href={"/" + type + "/leaderboard?page=" + (page - 1)}>{"<--"}</a>
      )
    }
    {
      page < leaderboardSize.pages - 1 && (
        <a href={"/" + type + "/leaderboard?page=" + (page + 1)}>{"-->"}</a>
      )
    }
    {
      page < leaderboardSize.pages - 1 && (
        <a
          href={"/" + type + "/leaderboard?page=" + (leaderboardSize.pages - 1)}
        >
          {"->>"}
        </a>
      )
    }
  </span>
</GlobalLayout>
